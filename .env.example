# Local values come from `npx supabase status -o env` (API_URL, SECRET_KEY).
# In production, use the hosted project's URL and secret key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_...

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application").
# Authorized redirect URI: <origin>/api/auth/callback, e.g. http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
