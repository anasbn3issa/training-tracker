# Local values come from `npx supabase status -o env` (API_URL, SECRET_KEY).
# In production, use the hosted project's URL and secret key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_...

# One password per user (ids in src/lib/users.ts). Use long ones in production.
PASSWORD_ANAS=
PASSWORD_ATEF=
# Signs the login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
